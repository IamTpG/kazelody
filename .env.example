# Mẫu biến môi trường của KazeLody. Sao chép thành `.env.local` (đã bị git bỏ qua) và điền giá trị thật.
# KHÔNG đặt giá trị thật vào file này và không commit bí mật.
#
# Dùng ở máy:    node --env-file=.env.local tools/push-tracks.mjs
# Dùng trên Vercel: đặt cùng các biến này trong Project Settings → Environment Variables
#                   (cả Production lẫn Preview). Chi tiết: README, phần "Nhạc trên Cloudflare R2".
#
# Không cần file này để chạy `npm run dev` hoặc `npm run dev:admin` (hai lệnh đó không dùng R2 thật).

# ---------- Cloudflare R2 (bắt buộc để phát nhạc từ R2 và để quản trị) ----------
# Cloudflare → R2 → bucket private → API token quyền "Object Read & Write" chỉ cho bucket này.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- Trang quản trị /admin (bắt buộc để dùng /api/admin/*) ----------
# Mật khẩu đăng nhập, tối thiểu 8 ký tự (nên dài hơn nhiều).
ADMIN_PASSWORD=
# Khoá ký cookie phiên, tối thiểu 32 ký tự ngẫu nhiên, ví dụ: openssl rand -hex 32
# Đổi giá trị này là mọi phiên đăng nhập hết hiệu lực.
SESSION_SECRET=

# ---------- Tuỳ chọn ----------
# Origin hợp lệ của site khi gọi API quản trị. Bỏ trống thì so với chính host của request
# (đúng cho cả Preview). Chỉ đặt khi có proxy viết lại header Origin, ví dụ: https://kazelody.iamtpg.dev
# PUBLIC_ORIGIN=

# Hạn của URL nghe nhạc ký sẵn, tính bằng giây (60 - 604800, mặc định 10800 = 3 giờ).
# Đặt ngắn (ví dụ 120) để thử cơ chế tự làm mới URL của player.
# R2_PRESIGN_TTL_SECONDS=

# ---------- Chỉ cho `npm run dev:admin` (môi trường thử, không cần Cloudflare) ----------
# DEV_ADMIN_PASSWORD=kazelody-dev
# PORT=5173
# DEV_API_PORT=8787
